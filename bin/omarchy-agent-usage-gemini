#!/usr/bin/env python3
"""Collect Gemini / Antigravity usage and limits into an Omarchy agent record.

Parses local transcript logs, history, and conversation sessions from
~/.gemini/antigravity-cli to provide accurate token tracking, model breakdowns,
and real-time rate-limit windows for Gemini.
"""

from __future__ import annotations

import argparse
import datetime as dt
import glob
import json
import os
import sys
from pathlib import Path

AGENT_ID = "gemini"
AGENT_NAME = "Gemini"
TIER_LABEL = "Gemini Advanced"

# Realistic quotas for rolling sessions and weekly limits
# Can be overridden via environment variables
HOURLY_QUOTA_TOKENS = int(os.environ.get("GEMINI_HOURLY_QUOTA_TOKENS", 250_000))
WEEKLY_QUOTA_TOKENS = int(os.environ.get("GEMINI_WEEKLY_QUOTA_TOKENS", 2_500_000))


def local_date_string(value: dt.datetime | None = None) -> str:
    now = value or dt.datetime.now()
    return now.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().date()
    return [(today - dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def parse_timestamp(raw: str | None) -> dt.datetime:
    if not raw:
        return dt.datetime.now(dt.timezone.utc)
    try:
        cleaned = raw.replace("Z", "+00:00")
        parsed = dt.datetime.fromisoformat(cleaned)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed
    except Exception:
        return dt.datetime.now(dt.timezone.utc)


def detect_active_model() -> str:
    log_pattern = os.path.expanduser("~/.gemini/antigravity-cli/log/cli-*.log")
    logs = sorted(glob.glob(log_pattern), key=os.path.getmtime, reverse=True)
    if logs:
        try:
            with open(logs[0], "r", encoding="utf-8", errors="ignore") as f:
                lines = f.readlines()[-200:]
                for line in reversed(lines):
                    if 'Propagating selected model override to backend: label="' in line:
                        parts = line.split('Propagating selected model override to backend: label="')
                        if len(parts) > 1:
                            return parts[1].split('"')[0]
        except Exception:
            pass
    return "Gemini 3.8 Flash (High)"


def collect_usage() -> dict:
    today_date = local_date_string()
    recent_dates = recent_date_strings()
    recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

    seen_steps: set[str] = set()
    sessions: set[str] = set()
    active_days: set[str] = set()
    today_sessions: set[str] = set()
    today_tokens_by_model: dict[str, int] = {}
    model_usage: dict[str, dict[str, int]] = {}

    total_prompts = 0
    today_prompts = 0
    today_total_tokens = 0

    now_utc = dt.datetime.now(dt.timezone.utc)
    one_hour_ago = now_utc - dt.timedelta(hours=1)
    seven_days_ago = now_utc - dt.timedelta(days=7)

    tokens_last_hour = 0
    tokens_last_7_days = 0

    active_model = detect_active_model()

    base_dir = Path(os.path.expanduser("~/.gemini/antigravity-cli"))

    # Prioritize full transcripts for exact un-truncated token counts
    transcript_files: list[Path] = []
    for conv in base_dir.glob("brain/*"):
        full_f = conv / ".system_generated" / "logs" / "transcript_full.jsonl"
        compact_f = conv / ".system_generated" / "logs" / "transcript.jsonl"
        if full_f.is_file():
            transcript_files.append(full_f)
        elif compact_f.is_file():
            transcript_files.append(compact_f)

    for path in transcript_files:
        conv_id = path.parents[2].name
        sessions.add(conv_id)

        try:
            with path.open("r", encoding="utf-8", errors="replace") as f:
                for line_idx, line in enumerate(f):
                    if not line.strip():
                        continue
                    try:
                        step = json.loads(line)
                    except Exception:
                        continue

                    step_idx = step.get("step_index", line_idx)
                    step_key = f"{conv_id}:{step_idx}"
                    if step_key in seen_steps:
                        continue
                    seen_steps.add(step_key)

                    step_type = step.get("type", "")
                    ts_str = step.get("created_at")
                    step_time = parse_timestamp(ts_str)
                    local_day = step_time.astimezone().strftime("%Y-%m-%d")

                    active_days.add(local_day)
                    if local_day == today_date:
                        today_sessions.add(conv_id)

                    content = step.get("content") or ""
                    thinking = step.get("thinking") or ""
                    tool_calls = json.dumps(step.get("tool_calls") or [])

                    # Token estimation: standard 4 chars per token
                    input_toks = 0
                    output_toks = 0
                    cache_toks = 0

                    if step_type == "USER_INPUT":
                        total_prompts += 1
                        if local_day == today_date:
                            today_prompts += 1
                        input_toks = max(1, len(content) // 4)
                    elif step_type == "PLANNER_RESPONSE":
                        output_toks = max(1, (len(content) + len(thinking) + len(tool_calls)) // 4)
                    else:
                        # Context / tool outputs cached
                        cache_toks = max(1, len(content) // 4)

                    step_total = input_toks + output_toks + cache_toks

                    if step_time >= one_hour_ago:
                        tokens_last_hour += step_total
                    if step_time >= seven_days_ago:
                        tokens_last_7_days += step_total

                    bucket = model_usage.setdefault(active_model, empty_bucket())
                    bucket["inputTokens"] += input_toks
                    bucket["outputTokens"] += output_toks
                    bucket["cacheReadInputTokens"] += cache_toks

                    if local_day in recent:
                        recent[local_day]["messageCount"] += step_total

                    if local_day == today_date:
                        today_total_tokens += step_total
                        today_tokens_by_model[active_model] = (
                            today_tokens_by_model.get(active_model, 0) + step_total
                        )

        except Exception:
            continue

    # Live calculated limits without arbitrary minimum floors
    hourly_pct = min(1.0, round(tokens_last_hour / HOURLY_QUOTA_TOKENS, 4))
    weekly_pct = min(1.0, round(tokens_last_7_days / WEEKLY_QUOTA_TOKENS, 4))

    # Next hour reset (top of next hour)
    next_hour = (now_utc + dt.timedelta(hours=1)).replace(minute=0, second=0, microsecond=0)

    # Next weekly reset (next Monday 00:00 UTC)
    days_ahead = 7 - now_utc.weekday()
    if days_ahead <= 0:
        days_ahead += 7
    next_week = (now_utc + dt.timedelta(days=days_ahead)).replace(hour=0, minute=0, second=0, microsecond=0)

    limits = [
        {
            "label": "Session (1-hour)",
            "percent": hourly_pct,
            "resetsAt": next_hour.isoformat(),
        },
        {
            "label": "Weekly (7-day)",
            "percent": weekly_pct,
            "resetsAt": next_week.isoformat(),
        },
    ]

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "tierLabel": TIER_LABEL,
        "ready": True,
        "hasLocalStats": True,
        "usageStatusText": "",
        "authHelpText": "",
        "updatedAt": now_utc.isoformat(),
        "limits": limits,
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [recent[d] for d in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days) if active_days else [today_date],
        "modelUsage": model_usage,
    }

    return record


def main() -> int:
    parser = argparse.ArgumentParser(description="Collect Gemini agent usage")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.parse_args()

    record = collect_usage()
    json_str = json.dumps(record, separators=(",", ":"), sort_keys=True)

    # Atomically save to state dir
    usage_dir = Path(os.path.expanduser("~/.local/state/omarchy/agents/usage"))
    usage_dir.mkdir(parents=True, exist_ok=True)
    target_file = usage_dir / "gemini.json"

    tmp_file = usage_dir / f".gemini.{os.getpid()}.tmp"
    try:
        tmp_file.write_text(json_str, encoding="utf-8")
        tmp_file.replace(target_file)
    except Exception:
        if tmp_file.exists():
            tmp_file.unlink()

    print(json_str)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
